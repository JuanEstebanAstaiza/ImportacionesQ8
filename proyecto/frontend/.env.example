# Copiar a .env o .env.local:
#   copy .env.example .env
#
# Vite solo expone variables con prefijo VITE_.
# Nunca pongas SECRET_KEY, SMTP, MYSQL ni secretos de Wompi aquí.

# Backend FastAPI (Docker Compose local)
# SIN sufijo /api: FastAPI monta sus routers en la raíz (/cursos, /documentos...).
# El /api solo existe como proxy del dev server y lo agrega el cliente cuando toca.
# Si la app se sirve desde un host remoto (Dev Tunnel, LAN, staging) y este valor
# apunta a loopback, el cliente lo ignora y usa el proxy same-origin de abajo,
# porque el browser del usuario no puede alcanzar localhost.
VITE_API_URL=http://localhost:8000

# Prefijo del proxy same-origin hacia el backend (server.proxy en vite.config.ts).
# Cambiar solo si el reverse proxy de producción usa otra ruta.
VITE_API_PROXY_PREFIX=/api

# WebSocket del mismo backend
VITE_WS_URL=ws://localhost:8000

# URL del propio frontend (deep links / reset password coherente con backend FRONTEND_URL)
VITE_APP_URL=http://localhost:5173

# Solo clave pública de Wompi si usas widget en el browser
VITE_WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxxxxxxxxxxxxxx
