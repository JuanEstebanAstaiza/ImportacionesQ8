# Copiar este archivo a ".env" y completar con valores reales.
# NUNCA subir el archivo ".env" con secretos reales al control de versiones.

# Base de datos MySQL
DATABASE_URL=mysql+pymysql://usuario:contraseña@localhost/importacionesq8

# JWT - usar un secreto largo y aleatorio en producción (ej. `openssl rand -hex 32`)
SECRET_KEY=cambiar-por-un-secreto-aleatorio-de-al-menos-32-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS - solo dominios autorizados del frontend, separados por coma
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Redis (cache de matching de cotizaciones abiertas)
REDIS_URL=redis://localhost:6379/0

# Wompi - pasarela de pagos
# WOMPI_PUBLIC_KEY se usa en el frontend para inicializar el widget de pago
WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxxxxxxxxxxxxxx
# WOMPI_SECRET_KEY nunca debe exponerse al frontend, solo se usa en el backend
WOMPI_SECRET_KEY=prv_test_xxxxxxxxxxxxxxxxxxxxxxxx
# WOMPI_EVENTS_SECRET se usa para verificar la firma HMAC de los webhooks entrantes
WOMPI_EVENTS_SECRET=cambiar-por-el-secreto-de-eventos-de-wompi

# Rate limiting (intentos de login/registro por IP)
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=10/minute
