
# Generar SECRET_KEY:  python -c "import secrets; print(secrets.token_hex(32))"

# development | production
APP_ENV=development

# Base de datos MySQL (ASCII only en password: evita fallos de URL/PyMySQL)
DATABASE_URL=mysql+pymysql://usuario_q8:password_q8@localhost/importacionesq8

# JWT — obligatorio; valor largo y aleatorio en producción
SECRET_KEY=cambiar-por-un-secreto-aleatorio-de-al-menos-32-caracteres
ALGORITHM=HS256
# TTL corto; renovar con /auth/refresh
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# Redis
REDIS_URL=redis://:redis_q8_dev_change_me@localhost:6379/0

# Docker Compose MySQL (solo ASCII)
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=importacionesq8
MYSQL_USER=usuario_q8
MYSQL_PASSWORD=password_q8
REDIS_PASSWORD=redis_q8_dev_change_me

# Uvicorn workers (Compose/Dockerfile)
WEB_CONCURRENCY=2

# Wompi
WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_SECRET_KEY=prv_test_xxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_EVENTS_SECRET=cambiar-por-el-secreto-de-eventos-de-wompi
# En production debe ser false e integrar API real
WOMPI_SIMULATE=true

# Rate limiting
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=10/minute
RATE_LIMIT_FORGOT_PASSWORD=5/minute

# SMTP
SMTP_HOST=smtp.tuservicio.com
SMTP_PORT=587
SMTP_USER=no-reply@importacionesq8.com
SMTP_PASSWORD=cambiar-por-la-contraseña-o-api-key-del-proveedor-smtp
SMTP_FROM=no-reply@importacionesq8.com
SMTP_USE_TLS=true
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_EXPIRE_MINUTES=15
OTP_EXPIRE_MINUTES=15
LOGIN_TARDIO_HORAS=72
RATE_LIMIT_OTP=10/minute

# Configuración de correo de contacto
CONTACT_EMAIL=contacto@importacionesq8.com

# Créditos del solicitante (quien cotiza) — DESACTIVADOS por defecto.
# false = no se cobra ni se vende créditos a personas naturales/jurídicas cotizantes.
# El cobro de la plataforma es a empresas importadoras (contrato), no al cotizante.
# Solo poner true si se reactiva el wallet de solicitantes.
COBRO_A_SOLICITANTES=false
# Valores históricos (solo aplican si COBRO_A_SOLICITANTES=true)
CREDITO_COSTO_COTIZACION_ABIERTA=10
CREDITO_COSTO_COTIZACION_DIRIGIDA=5
CREDITO_USD_POR_UNIDAD=0.1
CREDITO_BONO_REGISTRO=20
CREDITO_BONO_REFERIDO=10
CREDITO_BONO_REFERIDOR=10

# Minutos entre pasadas de recálculo de tiers de cotizantes (0 = desactivado)
TIER_RECALCULO_MINUTOS=60

# Notificaciones salientes (se suman siempre a la notificación in-app)
NOTIFICACIONES_EMAIL=true
NOTIFICACIONES_WHATSAPP=true

# WhatsApp vía open-wa / wa-automate (https://github.com/open-wa/wa-automate-nodejs).
# Levanta la instancia con la EASY API, p. ej.:
#   npx @open-wa/wa-automate --api-key mi-clave --port 8002
# Dejar OPENWA_API_URL vacío desactiva el envío (se registra en el log y sigue).
OPENWA_API_URL=http://localhost:8002
OPENWA_API_KEY=cambiar-por-la-api-key-de-tu-instancia-open-wa
OPENWA_SEND_PATH=/sendText
OPENWA_TIMEOUT_SECONDS=10
# Indicativo que se antepone a los teléfonos guardados sin país
WHATSAPP_INDICATIVO_POR_DEFECTO=57

# Módulo educativo (cursos/LMS). false = API en 404 y sección oculta en el frontend.
MODULO_EDUCATIVO_HABILITADO=true

# Traducción asistida (Google Cloud Translation API v2)
TRANSLATION_ENABLED=false
GOOGLE_TRANSLATE_API_KEY=
GOOGLE_TRANSLATE_PROJECT=
