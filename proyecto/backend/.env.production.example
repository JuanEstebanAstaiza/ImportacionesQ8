# .env de PRODUCCIÓN — plantilla. En el servidor:
#   cp .env.production.example .env   (y rellenar; .env nunca va a git)
#
# Genera cada secreto por separado con:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# MySQL/Redis: solo letras y números (van dentro de una URL de conexión).

# --- Dominio (Caddy pide el certificado HTTPS para él y para www.) ---
DOMINIO=zarpi.co

APP_ENV=production

# --- Seguridad / JWT ---
SECRET_KEY=GENERAR_64_HEX
ALGORITHM=HS256
# El frontend no renueva el token (/auth/refresh): con menos, la sesión se
# cerraría a mitad de uso.
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Mismo origen que el frontend (la API va por https://DOMINIO/api).
CORS_ORIGINS=https://zarpi.co,https://www.zarpi.co
# Base de los enlaces de los correos (recuperar contraseña, notificaciones).
FRONTEND_URL=https://zarpi.co

# --- MySQL (docker-compose arma DATABASE_URL con estos valores) ---
MYSQL_ROOT_PASSWORD=GENERAR
MYSQL_DATABASE=importacionesq8
MYSQL_USER=usuario_q8
MYSQL_PASSWORD=GENERAR

# --- Redis (docker-compose arma REDIS_URL con este valor) ---
REDIS_PASSWORD=GENERAR

# DATABASE_URL y REDIS_URL no se ponen aquí: docker-compose.yml las construye
# con los valores de arriba y apuntan a los contenedores mysql/redis.

# --- Servidor ---
WEB_CONCURRENCY=2
TIER_RECALCULO_MINUTOS=60

# --- Rate limiting (valores estrictos de producción) ---
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=10/minute
RATE_LIMIT_FORGOT_PASSWORD=5/minute
RATE_LIMIT_OTP=10/minute

# --- Correo (Resend). Sin esto nadie recibe el OTP y no se puede registrar ---
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_API_KEY=re_TU_API_KEY_DE_RESEND
SMTP_FROM=Zarpi <no-reply@zarpi.co>
SMTP_USE_TLS=true
CONTACT_EMAIL=contacto@zarpi.co
NOTIFICACIONES_EMAIL=true
OTP_EXPIRE_MINUTES=15
PASSWORD_RESET_EXPIRE_MINUTES=15
LOGIN_TARDIO_HORAS=72

# --- Wompi ---
# docker-compose.yml deja WOMPI_SIMULATE=true si no se define: decidirlo aquí.
# true mientras no haya llaves reales (los pagos se simulan).
WOMPI_SIMULATE=true
WOMPI_PUBLIC_KEY=pub_prod_xxxxxxxx
WOMPI_SECRET_KEY=prv_prod_xxxxxxxx
WOMPI_EVENTS_SECRET=GENERAR_O_EL_DE_WOMPI

# --- WhatsApp (open-wa). Vacío = desactivado ---
NOTIFICACIONES_WHATSAPP=false
OPENWA_API_URL=
OPENWA_API_KEY=

# --- Módulos ---
COBRO_A_SOLICITANTES=false
MODULO_EDUCATIVO_HABILITADO=true
TRANSLATION_ENABLED=false
