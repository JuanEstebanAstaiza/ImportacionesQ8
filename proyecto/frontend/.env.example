# Copiar a .env o .env.local:
#   copy .env.example .env
#
# Vite solo expone variables con prefijo VITE_.
# Nunca pongas SECRET_KEY, SMTP, MYSQL ni secretos de Wompi aquí.

# Backend FastAPI (Docker Compose local)
VITE_API_URL=http://localhost:8000

# WebSocket del mismo backend
VITE_WS_URL=ws://localhost:8000

# URL del propio frontend (deep links / reset password coherente con backend FRONTEND_URL)
VITE_APP_URL=http://localhost:5173

# Solo clave pública de Wompi si usas widget en el browser
VITE_WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxxxxxxxxxxxxxx
